import os
# Odblokowanie EXR w OpenCV - musi być na samym początku
os.environ["OPENCV_IO_ENABLE_OPENEXR"] = "1"

import cv2
import numpy as np
from pathlib import Path
from typing import Optional, Tuple, List

from .exceptions import ParseError, ValidationError, ChannelNotFound
from .base import BaseReader

class EXRReader(BaseReader):
    """
    Reader for EXR files that supports:
    - RGB channels named 'rgb_.R', 'rgb_.G', 'rgb_.B'
    - Instance segmentation channel 'inst_.V'
    - Semantic segmentation channel 'sem_.V'
    """

    def __init__(self, file_path: Path | str):
        super().__init__(file_path)
        self.file_path = Path(file_path)
        
        if not self.file_path.exists():
            raise FileNotFoundError(f"File not found: {self.file_path}")

        # Wczytujemy dane za pomocą OpenCV (zastępuje OpenEXR.InputFile)
        # IMREAD_UNCHANGED wczytuje wszystkie dostępne kanały w pełnej precyzji
        self._data = cv2.imread(str(self.file_path), cv2.IMREAD_ANYCOLOR | cv2.IMREAD_ANYDEPTH | cv2.IMREAD_UNCHANGED)
        
        if self._data is None:
            raise ParseError(f"Failed to open EXR: {self.file_path}")

        # Symulujemy listę kanałów, którą miałeś wcześniej
        # OpenCV zazwyczaj wczytuje to jako (H, W, C)
        self._num_channels = self._data.shape[2] if len(self._data.shape) > 2 else 1
        
        # Zakładamy mapowanie kanałów na podstawie Twojej specyfikacji
        # W plikach wielokanałowych OpenCV zachowuje kolejność z pliku
        self.channels = ["rgb_.R", "rgb_.G", "rgb_.B", "inst_.V", "sem_.V"]

    def list_channels(self) -> List[str]:
        return self.channels

    def read(self) -> np.ndarray:
        # Logika wyboru kanału (identyczna jak w Twoim oryginale)
        if "inst_.V" in self.channels and self._num_channels >= 4:
            return self.read_instance()
        if "sem_.V" in self.channels and self._num_channels >= 5:
            return self.read_semantic()
        return self.read_rgb()

    def read_rgb(self) -> np.ndarray:
        # OpenCV czyta BGR, zamieniamy na RGB
        if self._num_channels >= 3:
            rgb = self._data[:, :, :3]
            # Odwracamy BGR -> RGB
            return rgb[:, :, ::-1]
        raise ChannelNotFound("Missing RGB channels")

    def read_instance(self) -> np.ndarray:
        if self._num_channels >= 4:
            return self._data[:, :, 3]
        raise ChannelNotFound("Channel not found: inst_.V")

    def read_semantic(self) -> np.ndarray:
        if self._num_channels >= 5:
            return self._data[:, :, 4]
        raise ChannelNotFound("Channel not found: sem_.V")

    def _get_resolution(self) -> Tuple[int, int]:
        height, width = self._data.shape[:2]
        return width, height

    def close(self) -> None:
        self._data = None

    def __enter__(self) -> "EXRReader":
        return self

    def __exit__(self, exc_type, exc_val, exc_tb) -> None:
        self.close()
